# Nick AI
NICK_ENV=production
NICK_LOG_LEVEL=INFO
NICK_PROVIDER=openai_compatible

# Any OpenAI-compatible endpoint. Example: Hugging Face Inference Providers,
# OpenRouter, or a compatible self-hosted gateway.
NICK_API_BASE=https://router.huggingface.co/v1
NICK_API_KEY=
NICK_MODEL=Qwen/Qwen2.5-7B-Instruct

# Local Ollama alternative:
# NICK_PROVIDER=ollama
# NICK_OLLAMA_URL=http://localhost:11434
# NICK_MODEL=qwen2.5:3b

NICK_DATABASE_PATH=data/nick_ai.db
NICK_REQUEST_TIMEOUT=90
NICK_MAX_HISTORY=12
NICK_API_TOKEN=
